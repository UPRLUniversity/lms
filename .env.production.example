# ─────────────────────────────────────────────────────────────────────────────
# UPRL LMS — PRODUCTION environment template (Section 15)
#
# Copy to .env on the server and fill in. This file exists separately from
# .env.example because that one is the LOCAL template: it ships APP_DEBUG=true
# so a developer gets a useful error page, and copying it to a server is the
# mistake this file prevents.
#
# AppServiceProvider refuses to boot if APP_ENV=production and APP_DEBUG=true,
# so that particular mistake fails loudly rather than leaking credentials on the
# first uncaught exception.
#
# Never commit a filled-in copy of this file.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="UPRL LMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lms.uprl.edu.ng

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Generate with: php artisan key:generate
# Without APP_KEY the encrypted payment-method credentials cannot be read.
# LOSING IT MEANS LOSING THEM — back it up with your other secrets.

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ─── Database ────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uprl_lms
DB_USERNAME=
DB_PASSWORD=

# ─── Session / cache / queue ─────────────────────────────────────────────────
# Sessions and the queue both live in the database (no Redis dependency).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# A queue worker MUST be running or nothing is ever e-mailed and no certificate is
# ever rendered. See docs/production.md for the supervisor unit and the scheduler
# cron entry.

# ─── Mail ────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@uprl.edu.ng"
MAIL_FROM_NAME="${APP_NAME}"
# Where learners are told to write. Also settable at runtime in Settings → General.
MAIL_SUPPORT_ADDRESS="support@uprl.edu.ng"

# ─── Media ───────────────────────────────────────────────────────────────────
# Public images (avatars, covers, logos) go to Cloudinary; private files
# (submissions, certificate PDFs) stay on the private disk behind signed URLs.
MEDIA_DRIVER=cloudinary
CLOUDINARY_URL=
CLOUDINARY_ROOT_FOLDER=uprl

# Ceiling for the exceptional self-hosted lesson video.
LESSON_MEDIA_MAX_KB=25600

# ─── Proxy / TLS ─────────────────────────────────────────────────────────────
# TLS terminates at the load balancer, so Laravel must trust its forwarded headers
# or it will generate http:// URLs (breaking gateway callbacks and reset links).
# Narrow this from '*' to the balancer's addresses if the app is ever reachable
# directly.
TRUSTED_PROXIES=*

# ─── Commerce ────────────────────────────────────────────────────────────────
COMMERCE_CURRENCY=NGN
COMMERCE_CURRENCY_SYMBOL="₦"
COMMERCE_GUEST_CART_DAYS=30

# Gateway credentials are NOT set here. They are entered by an admin under
# Store → Payment methods and stored encrypted, so they can be rotated without a
# deploy — and every rotation is recorded in the audit trail without its value.
PAYSTACK_BASE_URL=https://api.paystack.co

# ─── Reporting ───────────────────────────────────────────────────────────────
REPORTS_QUEUE_THRESHOLD=2000

# ─── Audit trail ─────────────────────────────────────────────────────────────
# Unset means keep everything, which is the safe default for an audit log. Set a
# number of days only if you have a retention policy that requires deletion; the
# scheduled prune is the ONLY thing permitted to remove an entry.
# AUDIT_RETENTION_DAYS=
