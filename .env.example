APP_NAME="UPRL LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uprl_lms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Production uses the queued database driver (mail/notifications never block a
# request) — run a worker: `php artisan queue:work`. For quick local dev set this
# to "sync" so queued mail (e.g. invitations) sends inline with no worker.
#
# "sync" is only safe against a fake mailer (MAIL_MAILER=log) or for one-recipient
# sends. Against a real SMTP host a send costs seconds, and the fan-out paths —
# a course announcement, a pending-enrolment digest — deliver one message per
# recipient inside the request, so a class of 30 will exhaust max_execution_time
# and half-send. Real SMTP means QUEUE_CONNECTION=database plus a running worker.
QUEUE_CONNECTION=database

# Media / file storage (see config/media.php).
# MEDIA_DRIVER controls the backend for PUBLIC images: "local" (dev/test, no
# account needed) or "cloudinary". Private files always use the local "private" disk.
MEDIA_DRIVER=local
# Required only when MEDIA_DRIVER=cloudinary. Copy the "API environment variable"
# from your Cloudinary dashboard, e.g. cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Root folder for every public image: files land in <root>/<purpose>, e.g.
# uprl/course_covers. Give staging its own root so its uploads stay out of the
# live library when both point at one Cloudinary account.
CLOUDINARY_ROOT_FOLDER=uprl

# Comma-separated proxy addresses to trust, or "*" for any. Required whenever the
# app sits behind a tunnel (ngrok) or a load balancer, so it generates https://
# URLs instead of http:// — payment callbacks and webhook URLs depend on it.
TRUSTED_PROXIES=*

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" writes every e-mail to storage/logs/laravel.log and sends NOTHING. The app
# still reports success, so this looks identical to working delivery from the UI —
# set it to "smtp" the moment you want real mail to leave the building.
#
# For real delivery fill in the block below and use MAIL_SCHEME, not MAIL_ENCRYPTION:
# Laravel 11+ dropped MAIL_ENCRYPTION and it is silently ignored.
#   implicit TLS -> MAIL_SCHEME=smtps  MAIL_PORT=465
#   STARTTLS     -> MAIL_SCHEME=smtp   MAIL_PORT=587
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@uprl.edu.ng"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Row count above which a report export is queued instead of streamed inline.
# Lower it (e.g. 50) to demonstrate the queued path on a small dataset.
REPORTS_QUEUE_THRESHOLD=2000

# ─── Commerce (Section 12) ────────────────────────────────────────────────────
# The institution bills in one currency; multi-currency is out of scope.
COMMERCE_CURRENCY=NGN
COMMERCE_CURRENCY_SYMBOL="₦"

# How long a signed-out visitor's cart survives. Their cart is also held in the
# session; this cookie is what makes it outlive the session.
COMMERCE_GUEST_CART_DAYS=30

# Paystack. These are only SEED defaults for a fresh install — the live values are
# entered by an admin under Store → Payment methods and stored encrypted, so keys
# can be rotated without a deploy. Leave blank and configure in the UI.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# ─── Audit trail (Section 15) ─────────────────────────────────────────────────
# Unset means keep everything, which is the right default for an audit log. Set a
# number of days ONLY if a retention policy requires deletion; the scheduled prune
# is the only thing permitted to remove an entry.
# AUDIT_RETENTION_DAYS=

# Where learners are told to write when something goes wrong. Also settable at
# runtime under Settings → General, which overrides this.
MAIL_SUPPORT_ADDRESS="support@uprl.edu.ng"
